# Copy to .env. Generate TWO different secrets using: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg://biletflow_app:replace-app-password@localhost:5433/biletflow
POSTGRES_PASSWORD=replace-owner-password
APP_DB_PASSWORD=replace-app-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
CHALLENGE_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SMTP_HOST=localhost
SMTP_PORT=1025
