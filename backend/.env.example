# Used when running FastAPI or the worker natively from backend/.
# Keep the database password aligned with the root .env used by Docker Compose.
DATABASE_URL=postgresql+psycopg://biletflow_app:biletflow-app-local-password@localhost:5433/biletflow
POSTGRES_PASSWORD=biletflow-owner-local-password
APP_DB_PASSWORD=biletflow-app-local-password
JWT_SECRET=local-jwt-secret-change-before-production-1234567890
CHALLENGE_SECRET=local-challenge-secret-change-before-production-1234567890
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:8080"]
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SMTP_HOST=localhost
SMTP_PORT=1025
ADMISSION_REQUIRE_ENTRY_CONFIRMATION=true
ENTRY_CONFIRMATION_SECONDS=120
OFFLINE_PACKAGE_MINUTES=720
STORAGE_ROOT=var/storage
# local: files under STORAGE_ROOT. s3: an S3-compatible bucket, which also needs S3_ENDPOINT_URL,
# S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY (see README.md#private-file-storage).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_PER_MESSAGE=5
ATTACHMENT_LINK_SECONDS=300
# Optional GA4 integration (off by default); credentials only from the environment.
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GA4_CACHE_SECONDS=900
# Malware scanning of support attachments with ClamAV: `docker compose up -d clamav` from the
# repository root publishes clamd on localhost:3310. Without a reachable clamd, uploads stay
# quarantined. Only for local development without ClamAV, MALWARE_SCANNER=disabled marks uploads
# clean unscanned (refused when ENVIRONMENT=production).
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
