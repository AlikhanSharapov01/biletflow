# Used when running FastAPI or the worker natively from backend/.
# Keep the database password aligned with the root .env used by Docker Compose.
DATABASE_URL=postgresql+psycopg://biletflow_app:biletflow-app-local-password@localhost:5433/biletflow
POSTGRES_PASSWORD=biletflow-owner-local-password
APP_DB_PASSWORD=biletflow-app-local-password
JWT_SECRET=local-jwt-secret-change-before-production-1234567890
CHALLENGE_SECRET=local-challenge-secret-change-before-production-1234567890
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:8080"]
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SMTP_HOST=localhost
SMTP_PORT=1025
