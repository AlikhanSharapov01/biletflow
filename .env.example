# Local development defaults. Replace every password/secret before a real deployment.
POSTGRES_PASSWORD=biletflow-owner-local-password
APP_DB_PASSWORD=biletflow-app-local-password
DATABASE_URL=postgresql+psycopg://biletflow_app:biletflow-app-local-password@localhost:5433/biletflow

JWT_SECRET=local-jwt-secret-change-before-production-1234567890
CHALLENGE_SECRET=local-challenge-secret-change-before-production-1234567890
ENVIRONMENT=development
COOKIE_SECURE=false

# API worker processes in Docker Compose (#118), passed to uvicorn as WEB_CONCURRENCY. Each
# process holds up to 15 database connections; keep it at 5 or less with PostgreSQL's default
# max_connections of 100. A natively run API ignores it.
API_WORKERS=2

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:8080"]
FRONTEND_URL=http://localhost:8080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

SMTP_HOST=localhost
SMTP_PORT=1025
ADMISSION_REQUIRE_ENTRY_CONFIRMATION=true
ENTRY_CONFIRMATION_SECONDS=120
OFFLINE_PACKAGE_MINUTES=720
STORAGE_ROOT=var/storage
# Private object storage (#77). A natively run API keeps files under STORAGE_ROOT
# (STORAGE_BACKEND=local); Docker Compose sets STORAGE_BACKEND=s3 for api and worker and runs the
# S3-compatible SeaweedFS service. STORAGE_ADMIN_* is the storage administrator, used only by
# storage-init to create the bucket; api and worker use S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY,
# which may only list, read, write and delete objects in S3_BUCKET. Use only letters, digits,
# ".", "_" and "-" in these values.
STORAGE_BACKEND=local
S3_REGION=us-east-1
S3_BUCKET=biletflow-private
S3_ACCESS_KEY_ID=biletflow-app
S3_SECRET_ACCESS_KEY=biletflow-app-storage-local-password
STORAGE_ADMIN_ACCESS_KEY_ID=biletflow-storage-admin
STORAGE_ADMIN_SECRET_ACCESS_KEY=biletflow-storage-admin-local-password
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_PER_MESSAGE=5
ATTACHMENT_LINK_SECONDS=300
# Optional GA4 integration (off by default); see backend/ANALYTICS_API.md.
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
GA4_CACHE_SECONDS=900
# Malware scanning of support attachments: ClamAV's clamd (the compose `clamav` service; Compose
# points the API and worker at it). Without ClamAV, uploads stay quarantined. For native local
# development without ClamAV only, MALWARE_SCANNER=disabled marks uploads clean unscanned
# (refused when ENVIRONMENT=production).
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
