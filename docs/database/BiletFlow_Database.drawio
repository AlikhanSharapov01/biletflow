        <mxCell id="box17-title" value="04 / TX: accept exactly once" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
