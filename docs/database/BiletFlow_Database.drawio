  <diagram id="bf-page-35" name="Rules 01-06">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="834" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Integrity rules / 1-6" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Enforcement is deliberately explicit: foreign keys alone cannot enforce financial state transitions or authorization." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="146" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="C01 / PK identity" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Every table uses immutable UUID id and server created_at.&#10;&#10;ENFORCEMENT: DDL&#10;REFERENCE: All tables&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="86" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="C02 / Requiredness and bounded values" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Non-null columns, state sets, positive amounts, date ordering and arithmetic are CHECK/NOT&#10;NULL constraints listed per table.&#10;&#10;ENFORCEMENT: DDL&#10;REFERENCE: Data dictionary / schema.sql&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box11" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="336" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box11-title" value="C03 / Same-event and same-organization references" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="336" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box11-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Composite FKs prevent ticket/type/seat/hold/order/staff/payout context mismatches.&#10;Optional-FK NULLs use MATCH SIMPLE; guards require context where needed.&#10;&#10;ENFORCEMENT: DDL + TX for indirect paths&#10;REFERENCE: 129 FKs; TX-02/03/07/18&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="389" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box15" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="355" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box15-title" value="C04 / No double-selling a seat" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="355" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box15-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One allocation in held/sold/refund_quarantine per non-null event_seat_id, including&#10;expired-but-not-yet-closed holds.&#10;&#10;ENFORCEMENT: DDL partial unique + TX&#10;REFERENCE: uq_live_seat; TX-05/06/08/14&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="408" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box19" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="531" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box19-title" value="C05 / General admission/event capacity" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="531" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box19-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Count active allocation states after event mutex. Live held rows count until explicit&#10;release; sold and refund_quarantine count. Validate type and event capacity before&#10;insert/edit.&#10;&#10;ENFORCEMENT: TX&#10;REFERENCE: TX-03/05/06/08/14&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="584" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box23" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="550" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box23-title" value="C06 / Assigned-seat requirement" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="550" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box23-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Assigned mode requires allocation.event_seat_id; general mode forbids it. Seat is&#10;unblocked, mapped to selected type and event. Count configured unblocked seats consistently&#10;with event capacity/type limits.&#10;&#10;ENFORCEMENT: TX + composite FK&#10;REFERENCE: TX-03/05&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="603" width="652" height="124" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-36" name="Rules 07-12">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="815" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Integrity rules / 7-12" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Enforcement is deliberately explicit: foreign keys alone cannot enforce financial state transitions or authorization." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="C07 / One purchase per hold/allocation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;UNIQUE(ticket_order.hold_id), UNIQUE(order_item.allocation_id); item composite FKs enforce&#10;same hold/event/type.&#10;&#10;ENFORCEMENT: DDL&#10;REFERENCE: ticket_order/order_item&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="C08 / One ticket per admission unit" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;UNIQUE(ticket.order_item_id). TX must issue all and only the fulfilled order&amp;#x27;s items;&#10;pending/failed orders have no ticket.&#10;&#10;ENFORCEMENT: DDL upper bound + TX exact count&#10;REFERENCE: TX-08&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box11" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="355" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box11-title" value="C09 / Single fulfillment, preserve extra charges" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="355" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box11-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Unique fulfillment attempt reference, immutable confirmed_at and guarded pending-&amp;gt;confirmed&#10;transition. Multiple successful payment attempts permitted; extras compensated.&#10;&#10;ENFORCEMENT: DDL + TX&#10;REFERENCE: TX-08/09&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="408" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box15" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="355" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box15-title" value="C10 / Authoritative payment matching" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="355" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box15-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Selected fulfillment/activation payment must belong to that exact target&amp;#x27;s intent; status&#10;succeeded and amount/currency/environment match. Same-event FK alone is insufficient.&#10;&#10;ENFORCEMENT: TX&#10;REFERENCE: TX-08/09/16&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="408" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box19" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="550" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box19-title" value="C11 / One full refund per charge" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="550" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box19-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;UNIQUE(refund.payment_attempt_id); amount equals actual successful charge. Failures retry&#10;the same obligation; unknown outcome reconciles.&#10;&#10;ENFORCEMENT: DDL + TX&#10;REFERENCE: TX-13/14&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="603" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box23" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="550" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box23-title" value="C12 / Refund sequencing" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="550" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box23-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Invalidate/quarantine and commit before external request. Only authoritative success&#10;releases; compensation for another attempt does not invalidate legitimate order tickets.&#10;&#10;ENFORCEMENT: TX&#10;REFERENCE: TX-13/14&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="603" width="652" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-37" name="Rules 13-18">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="853" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Integrity rules / 13-18" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Enforcement is deliberately explicit: foreign keys alone cannot enforce financial state transitions or authorization." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="C13 / Campaign lifetime allowance" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Under event+campaign lock: redemption count + active reservation count &amp;lt; max before new&#10;allowance; refund leaves redemptions intact. One active reservation per hold and one&#10;redemption per order.&#10;&#10;ENFORCEMENT: DDL + TX&#10;REFERENCE: uq_active_promo_hold; TX-05/08/17&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="C14 / Correct discount/fee arithmetic" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Unit sums equal saved order totals; integer rounding and remainder allocation exact.&#10;Percent eligible lines only; fixed discount once per order; no stacking.&#10;&#10;ENFORCEMENT: DDL row arithmetic + TX aggregate&#10;REFERENCE: TX-07/08&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box11" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="374" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box11-title" value="C15 / Current admission uniqueness" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="374" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box11-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Partial UNIQUE(ticket_id) WHERE reversed_at IS NULL; unique consumed entry confirmation and&#10;device operation key.&#10;&#10;ENFORCEMENT: DDL&#10;REFERENCE: uq_current_admission&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="427" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box15" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="355" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box15-title" value="C16 / Admission correctness" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="355" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box15-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Verified claimed attendee, current attendee/scanner sessions, same-event permission,&#10;gate/time checks and valid state required. Check-in + token consumption + ticket state +&#10;audit are one commit.&#10;&#10;ENFORCEMENT: TX + composite FK&#10;REFERENCE: TX-10/11&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="408" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box19" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="569" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box19-title" value="C17 / Reversal preserves evidence" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="569" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box19-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Unique reversal per check_in; reversal row and reversed_at update atomically. Do not&#10;restore already invalid ticket or reuse consumed proof.&#10;&#10;ENFORCEMENT: DDL + TX&#10;REFERENCE: TX-12&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="622" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box23" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="569" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box23-title" value="C18 / Offline separation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="569" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box23-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Client IDs intentionally untrusted; validate to resolved FK IDs. Current-state&#10;reconciliation can reject stale operations; provisional records never inflate authoritative&#10;attendance.&#10;&#10;ENFORCEMENT: DDL + TX&#10;REFERENCE: TX-20&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="622" width="652" height="124" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-38" name="Rules 19-24">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="853" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Integrity rules / 19-24" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Enforcement is deliberately explicit: foreign keys alone cannot enforce financial state transitions or authorization." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="C19 / Scoped authorization" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Owner/member/capability and resource relationships checked on every&#10;read/write/download/subscribe. Composite FKs do not replace access control. No unrestricted&#10;browser/mobile DB access.&#10;&#10;ENFORCEMENT: APP + TX&#10;REFERENCE: All operations; access matrix&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="C20 / Historical snapshot immutability" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Post-quote price/recipient/seat snapshots and historical FKs do not change; creating new&#10;order after expiry/rebuy is required. Audit/messages/ledger/redemption/terms changes are&#10;rejected by append-only triggers.&#10;&#10;ENFORCEMENT: DDL trigger for append-only; TX for snapshot guards&#10;REFERENCE: TX-07/08/14/24&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box11" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="374" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box11-title" value="C21 / Payout solvency" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="374" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box11-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;After event mutex, subtract pending payouts and every unresolved full refund liability from&#10;actual ledger balance. No sandbox/live transfer; successful debit keyed once. Later refund&#10;appends adjustment.&#10;&#10;ENFORCEMENT: TX + unique ledger sources&#10;REFERENCE: TX-21&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="427" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box15" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="374" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box15-title" value="C22 / Durable side effects" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="374" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box15-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Audit/outbox insert in business transaction; remote calls after commit. Leased workers&#10;fence acknowledgements; domain idempotency remains after job retries.&#10;&#10;ENFORCEMENT: DDL key/row checks + TX&#10;REFERENCE: TX-22&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="427" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box19" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="588" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box19-title" value="C23 / Delete/retention safety" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="588" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box19-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;All FK deletes/updates RESTRICT. No normal hard-delete domain API. Append-only tables&#10;reject UPDATE/DELETE; owner/migration role is outside ordinary application permissions.&#10;&#10;ENFORCEMENT: DDL + APP&#10;REFERENCE: TX-26&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="641" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box23" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="569" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box23-title" value="C24 / Private context consistency" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="569" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box23-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Private access is account grant/authorized role. If support includes order and ticket,&#10;ticket&amp;#x27;s item must belong to that order; GA4 connection must belong to event organization.&#10;&#10;ENFORCEMENT: Composite FK + TX&#10;REFERENCE: TX-18/25&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="622" width="652" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-39" name="Rules 25-28">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="639" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Integrity rules / 25-28" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Enforcement is deliberately explicit: foreign keys alone cannot enforce financial state transitions or authorization." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="184" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="C25 / Files and sensitive data" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Clean content before link/download; purpose/MIME/size verified. Encrypt sensitive&#10;payout/file/backup data, hash one-time secrets; secrets stay out of logs, audit, jobs and&#10;analytics.&#10;&#10;ENFORCEMENT: DDL basic shape + APP/storage&#10;REFERENCE: TX-19/22&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="124" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="C26 / Time and derived state" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;UTC instants plus valid named zone; database clock decides expiry, no time-dependent index&#10;predicates. Upcoming/active/completed and seat availability are derived.&#10;&#10;ENFORCEMENT: DDL ordering + TX&#10;REFERENCE: TX-03/05/25&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box11" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="374" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box11-title" value="C27 / Calendar identity and event copy" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="374" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box11-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Event UID unique/stable, sequence increases on material changes. Duplicate creates new&#10;UID/IDs and whitelisted configuration only.&#10;&#10;ENFORCEMENT: DDL uniqueness + TX&#10;REFERENCE: TX-04/15/24&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="427" width="652" height="105" as="geometry" />
        </mxCell>
        <mxCell id="box15" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="355" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="box15-title" value="C28 / Metrics do not multiply money" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="355" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box15-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Aggregate each grain before joins: order/item, successful payment, successful refund,&#10;current admission. Optional GA4 cache never overwrites canonical amounts.&#10;&#10;ENFORCEMENT: QUERY contract&#10;REFERENCE: TX-25&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="408" width="652" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-40" name="Checkout activity">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1310" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Checkout / hold to canonical ticket" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="UML-style activity sequence. DB boxes are atomic commits; orange external actions occur after commit. Failure/alternate paths are stated inside each action." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="160" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="01 / Authenticate and quote" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="280" y="160" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Verified buyer; authorized event; server calculates immutable KZT amounts.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="213" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="340" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="02 / TX: reserve inventory + promotion" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="280" y="340" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Lock event. INSERT hold + allocations; reserve campaign allowance. COMMIT.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="393" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="box3" target="box7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box12" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="520" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box12-title" value="03 / TX: order + payment intent" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="280" y="520" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box12-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;INSERT one order_item per admission; persist snapshots. Positive total -&amp;gt; payment attempt/outbox; zero total -&amp;gt;&#10;fulfill. COMMIT.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="573" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="box7" target="box12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box17" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="700" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box17-title" value="04 / External provider / simulator" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="280" y="700" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box17-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Initialize/complete payment outside DB transaction. Authoritative callback or status query; never trust browser&#10;redirect.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="753" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e21" edge="1" parent="1" source="box12" target="box17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box22" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="880" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box22-title" value="05 / TX: fulfill OR compensate" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="280" y="880" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box22-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Lock event; recheck expiry, gates, amount and promo. Success: consume hold/promo, allocations sold, order&#10;confirmed, tickets inserted. Late/extra charge: refund obligation, NO extra ticket.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="933" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e26" edge="1" parent="1" source="box17" target="box22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box27" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="1060" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box27-title" value="06 / Post-commit delivery" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="280" y="1060" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box27-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Persisted jobs generate PDFs, email and analytics. Repeated messages do not duplicate orders/tickets.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="1113" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e31" edge="1" parent="1" source="box22" target="box27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-41" name="Refund activity">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1310" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Refund / invalidation before money return" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1300" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="UML-style activity sequence. DB boxes are atomic commits; orange external actions occur after commit. Failure/alternate paths are stated inside each action." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="160" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="01 / Approve full actual paid amount" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="280" y="160" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Check authorized actor, saved policy and check-in status. One refund per charged attempt.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="213" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="340" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="02 / TX-A: invalidate + quarantine" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="280" y="340" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Lock event/order/tickets. Tickets -&amp;gt; refund_pending; allocations -&amp;gt; refund_quarantine; INSERT refund + audit +&#10;outbox. COMMIT.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="393" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="box3" target="box7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box12" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="520" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box12-title" value="03 / External request after COMMIT" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="280" y="520" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box12-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Send refund with stable logical request key. Provider accepted/pending is NOT refund success.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="573" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="box7" target="box12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box17" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="700" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box17-title" value="04 / Pending / failed / unknown" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="280" y="700" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box17-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Keep ticket INVALID and inventory BLOCKED. Persist attempt. Retry/reconcile the same obligation; never release&#10;early.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="753" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e21" edge="1" parent="1" source="box12" target="box17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box22" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="280" y="880" width="840" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box22-title" value="05 / TX-B: confirmed success" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="280" y="880" width="840" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box22-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Lock event. Refund -&amp;gt; succeeded; old tickets -&amp;gt; refunded; allocations -&amp;gt; released once; financial effects + audit&#10;+ notification. COMMIT.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="294" y="933" width="812" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e26" edge="1" parent="1" source="box17" target="box22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Arial;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
