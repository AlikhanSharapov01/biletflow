        <mxCell id="v1" value="03 Events / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
