        </mxCell>
        <mxCell id="moderation_action-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Append-only moderation evidence; exactly one real target.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;actor_user_id: uuid [FK NN]&#10;target_user_id: uuid [FK ?]&#10;target_event_id: uuid [FK ?]&#10;target_activation_id: uuid [FK ?]&#10;action: text [NN]&#10;reason: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: num_nonnulls(target_user_id,target_event_id,target_activation_id) = 1&#10;CK2: action IN (&amp;#x27;suspend&amp;#x27;,&amp;#x27;reinstate&amp;#x27;)&#10;CK3: length(btrim(reason)) &amp;gt; 0&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(target_event_id) -&amp;gt; event(id) [0..1 parent / 0..* children]&#10;(target_activation_id) -&amp;gt; sales_activation(id) [0..1 parent / 0..* children]&#10;(actor_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(target_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="504" as="geometry" />
        </mxCell>
        <mxCell id="platform_setting_version" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="798" width="680" height="469" as="geometry" />
        </mxCell>
        <mxCell id="platform_setting_version-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; platform_setting_version" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
