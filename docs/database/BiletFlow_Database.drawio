        <mxCell id="box17-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Recheck current user/session, permission, event, ticket and proof. Accept through online check-in transaction or&#10;record rejection/conflict.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
