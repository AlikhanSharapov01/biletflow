<mxfile host="app.diagrams.net" type="device" compressed="false" version="26.0.0">
  <diagram id="bf-page-01" name="00 Start here">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1500" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="BiletFlow / database atlas" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="FastAPI + PostgreSQL | Full academic scope | Editable UML-style relational schema and transaction specification" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box3" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="165" width="680" height="336" as="geometry" />
        </mxCell>
        <mxCell id="box3-title" value="HOW TO READ THIS ATLAS" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="50" y="165" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;66 tables, all columns and constraints, scoped foreign keys, and operation contracts.&#10;&#10;Pages 01-16: domain tables. Every FK is listed with exact column mapping and UML&#10;multiplicity. Cross-page references name the target table; they are not missing&#10;relationships.&#10;&#10;CORE RELATIONS: simplified visual spine.&#10;RULES: global invariants and enforcement layer.&#10;ACTIVITIES: checkout, refund, admission, offline and durable delivery.&#10;OPERATIONS: every transaction write set and failure behavior.&#10;STATES: permitted transitions and guards.&#10;&#10;Companion specification includes full data dictionary, relationship catalogue, indexes,&#10;access rules and SQL enforcement boundary.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="218" width="652" height="276" as="geometry" />
        </mxCell>
        <mxCell id="box7" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="165" width="680" height="336" as="geometry" />
        </mxCell>
        <mxCell id="box7-title" value="NOTATION / ENFORCEMENT" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="165" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box7-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;&amp;lt;&amp;lt;table&amp;gt;&amp;gt; = physical relational table shown as UML class.&#10;PK = primary key; FK = foreign key; UQ = unique key.&#10;NN = NOT NULL; ? = nullable.&#10;A child FK points to 1 or 0..1 parent.&#10;A parent has 0..* children unless a unique FK limits it to 0..1.&#10;No composition diamonds: deletes do NOT cascade.&#10;&#10;DDL = enforced by supplied PostgreSQL schema.&#10;TX = required atomic application transaction; not implemented by DDL alone.&#10;APP = authorization, parsing, storage or provider code.&#10;QUERY = read-model/query correctness.&#10;&#10;All money is bigint minor units: 1 KZT = 100.&#10;Times use timestamptz; event stores its named timezone.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="218" width="652" height="276" as="geometry" />
        </mxCell>
        <mxCell id="box11" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="840" width="680" height="222" as="geometry" />
        </mxCell>
        <mxCell id="box11-title" value="CRITICAL USER RULE" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="50" y="840" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box11-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Refund approval first invalidates the original ticket and quarantines inventory. Commit&#10;this BEFORE asking the provider for a refund.&#10;&#10;Pending, uncertain or failed refunds do not make stock saleable. Only authoritative refund&#10;success releases the allocation.&#10;&#10;A later buyer receives a NEW allocation, order item and ticket. The old ticket and all&#10;financial relations remain in history.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="893" width="652" height="162" as="geometry" />
        </mxCell>
        <mxCell id="box15" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="840" width="680" height="260" as="geometry" />
        </mxCell>
        <mxCell id="box15-title" value="SCOPE AND STATUS" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="790" y="840" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="box15-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;This is a design baseline, not a claim that the application or migrations are deployed.&#10;&#10;All requirements modules and bonuses are represented. Real-money operation and production&#10;KYC remain excluded.&#10;&#10;Proposed defaults such as recipient claiming, one-time attendee entry proof and offline&#10;final admission remain labelled in the specification.&#10;&#10;Offline operations are provisional. They become central admissions only after current-state&#10;validation on reconnect.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="893" width="652" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-02" name="01 Identity">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1354" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="01 Identity / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="app_user" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="583" as="geometry" />
        </mxCell>
        <mxCell id="app_user-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; app_user" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="app_user-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Verified account; roles are scoped memberships, not one global role.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;email: text [UQ NN]&#10;password_hash: text [NN]&#10;display_name: text [NN]&#10;locale: text [NN]&#10;  default &amp;#x27;ru&amp;#x27;&#10;status: text [NN]&#10;  default &amp;#x27;active&amp;#x27;&#10;email_verified_at: timestamptz [?]&#10;analytics_consent: boolean [NN]&#10;  default false&#10;consent_recorded_at: timestamptz [?]&#10;updated_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (email)&#10;CK1: email = lower(btrim(email)) AND position(&amp;#x27;@&amp;#x27; in email) &amp;gt; 1&#10;CK2: locale IN (&amp;#x27;kk&amp;#x27;,&amp;#x27;ru&amp;#x27;,&amp;#x27;en&amp;#x27;)&#10;CK3: status IN (&amp;#x27;active&amp;#x27;,&amp;#x27;suspended&amp;#x27;)&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="523" as="geometry" />
        </mxCell>
        <mxCell id="auth_session" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="507" as="geometry" />
        </mxCell>
        <mxCell id="auth_session-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; auth_session" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="auth_session-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Revocable web or scanner session with rotated refresh-token digest.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;user_id: uuid [FK NN]&#10;refresh_token_hash: text [UQ NN]&#10;client_kind: text [NN]&#10;expires_at: timestamptz [NN]&#10;revoked_at: timestamptz [?]&#10;last_seen_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (refresh_token_hash)&#10;UQ2: (id, user_id)&#10;CK1: client_kind IN (&amp;#x27;web&amp;#x27;,&amp;#x27;scanner&amp;#x27;)&#10;CK2: expires_at &amp;gt; created_at&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="447" as="geometry" />
        </mxCell>
        <mxCell id="account_token" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="779" width="680" height="469" as="geometry" />
        </mxCell>
        <mxCell id="account_token-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; account_token" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="50" y="779" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="account_token-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One-use email-verification or password-reset challenge.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;user_id: uuid [FK NN]&#10;purpose: text [NN]&#10;token_hash: text [UQ NN]&#10;expires_at: timestamptz [NN]&#10;consumed_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (token_hash)&#10;CK1: purpose IN (&amp;#x27;email_verify&amp;#x27;,&amp;#x27;password_reset&amp;#x27;)&#10;CK2: expires_at &amp;gt; created_at&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="832" width="652" height="409" as="geometry" />
        </mxCell>
        <mxCell id="platform_admin" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="703" width="680" height="412" as="geometry" />
        </mxCell>
        <mxCell id="platform_admin-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; platform_admin" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="790" y="703" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="platform_admin-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Explicit audited internal-staff grant; unrelated to organization membership.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;user_id: uuid [FK UQ NN]&#10;granted_by_user_id: uuid [FK ?]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (user_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(user_id) -&amp;gt; app_user(id) [1 parent / 0..1 children]&#10;(granted_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="756" width="652" height="352" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-03" name="02 Organizations">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1840" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="02 Organizations / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="organization" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="488" as="geometry" />
        </mxCell>
        <mxCell id="organization-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; organization" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="organization-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Organizer workspace; one owner remains even if other memberships are revoked.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;owner_user_id: uuid [FK NN]&#10;name: text [NN]&#10;contact_email: text [NN]&#10;contact_phone: text [?]&#10;status: text [NN]&#10;  default &amp;#x27;active&amp;#x27;&#10;updated_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: status IN (&amp;#x27;active&amp;#x27;,&amp;#x27;suspended&amp;#x27;)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(owner_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="428" as="geometry" />
        </mxCell>
        <mxCell id="organization_member" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="507" as="geometry" />
        </mxCell>
        <mxCell id="organization_member-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; organization_member" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="organization_member-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Workspace membership, including scanner-only members.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;organization_id: uuid [FK NN]&#10;user_id: uuid [FK NN]&#10;status: text [NN]&#10;  default &amp;#x27;active&amp;#x27;&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (organization_id, user_id)&#10;UQ2: (id, organization_id)&#10;CK1: status IN (&amp;#x27;active&amp;#x27;,&amp;#x27;revoked&amp;#x27;)&#10;CK2: (status = &amp;#x27;revoked&amp;#x27;) = (revoked_at IS NOT NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(organization_id) -&amp;gt; organization(id) [1 parent / 0..* children]&#10;(user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="447" as="geometry" />
        </mxCell>
        <mxCell id="member_permission" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="684" width="680" height="393" as="geometry" />
        </mxCell>
        <mxCell id="member_permission-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; member_permission" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="684" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="member_permission-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Organization-level capability, excluding implicit ownership.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;member_id: uuid [FK NN]&#10;capability: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (member_id, capability)&#10;CK1: capability IN (&amp;#x27;manage_profile&amp;#x27;,&amp;#x27;manage_staff&amp;#x27;,&amp;#x27;finance&amp;#x27;)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(member_id) -&amp;gt; organization_member(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="737" width="652" height="333" as="geometry" />
        </mxCell>
        <mxCell id="staff_invitation" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="703" width="680" height="583" as="geometry" />
        </mxCell>
        <mxCell id="staff_invitation-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; staff_invitation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="703" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="staff_invitation-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Expiring workspace invitation; owner configures final event permissions on acceptance.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;organization_id: uuid [FK NN]&#10;email: text [NN]&#10;invited_by_user_id: uuid [FK NN]&#10;token_hash: text [UQ NN]&#10;expires_at: timestamptz [NN]&#10;accepted_by_user_id: uuid [FK ?]&#10;accepted_at: timestamptz [?]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (token_hash)&#10;CK1: email = lower(btrim(email))&#10;CK2: expires_at &amp;gt; created_at&#10;CK3: (accepted_at IS NULL) = (accepted_by_user_id IS NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(organization_id) -&amp;gt; organization(id) [1 parent / 0..* children]&#10;(invited_by_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(accepted_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="756" width="652" height="523" as="geometry" />
        </mxCell>
        <mxCell id="event_staff" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="1113" width="680" height="469" as="geometry" />
        </mxCell>
        <mxCell id="event_staff-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; event_staff" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="1113" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="event_staff-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Event assignment constrained to membership in the event&amp;#x27;s organization.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;organization_id: uuid [FK NN]&#10;member_id: uuid [FK NN]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id, member_id)&#10;UQ2: (id, event_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id, organization_id) -&amp;gt; event(id, organization_id) [1 parent / 0..* children]&#10;(member_id, organization_id) -&amp;gt; organization_member(id, organization_id) [1 parent / 0..*&#10;children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="1166" width="652" height="409" as="geometry" />
        </mxCell>
        <mxCell id="staff_permission" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="1322" width="680" height="412" as="geometry" />
        </mxCell>
        <mxCell id="staff_permission-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; staff_permission" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="1322" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="staff_permission-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Event-level permission set; multiple capabilities per assignment.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_staff_id: uuid [FK NN]&#10;capability: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_staff_id, capability)&#10;CK1: capability IN&#10;(&amp;#x27;event_edit&amp;#x27;,&amp;#x27;attendees&amp;#x27;,&amp;#x27;support&amp;#x27;,&amp;#x27;reports&amp;#x27;,&amp;#x27;refund&amp;#x27;,&amp;#x27;scan&amp;#x27;,&amp;#x27;reverse_checkin&amp;#x27;,&amp;#x27;staff&amp;#x27;)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_staff_id) -&amp;gt; event_staff(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="1375" width="652" height="352" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
