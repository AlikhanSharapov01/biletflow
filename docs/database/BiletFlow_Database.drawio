        <mxCell id="venue-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; venue" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="venue-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Reusable physical location; address snapshotted on orders.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;name: text [NN]&#10;address: text [NN]&#10;city: text [NN]&#10;country_code: text [NN]&#10;  default &amp;#x27;KZ&amp;#x27;&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: country_code = &amp;#x27;KZ&amp;#x27;&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="314" as="geometry" />
