        <mxCell id="v1" value="14 Files and support / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="stored_file" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="583" as="geometry" />
        </mxCell>
        <mxCell id="stored_file-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; stored_file" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="stored_file-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Object storage metadata; DB transaction does not pretend to atomically commit remote&#10;bytes.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;uploaded_by_user_id: uuid [FK ?]&#10;object_key: text [UQ NN]&#10;purpose: text [NN]&#10;mime_type: text [NN]&#10;size_bytes: bigint [NN]&#10;sha256: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;scanned_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (object_key)&#10;CK1: purpose IN (&amp;#x27;event_image&amp;#x27;,&amp;#x27;ticket_pdf&amp;#x27;,&amp;#x27;support_attachment&amp;#x27;,&amp;#x27;offline_package&amp;#x27;)&#10;CK2: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;quarantined&amp;#x27;,&amp;#x27;clean&amp;#x27;,&amp;#x27;rejected&amp;#x27;,&amp;#x27;deleted&amp;#x27;)&#10;CK3: size_bytes &amp;gt;= 0&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(uploaded_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="523" as="geometry" />
        </mxCell>
        <mxCell id="support_case" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="849" as="geometry" />
        </mxCell>
        <mxCell id="support_case-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; support_case" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="support_case-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One contextual thread, resolved through current relationships and explicit escalation.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;requester_user_id: uuid [FK NN]&#10;organization_id: uuid [FK ?]&#10;event_id: uuid [FK ?]&#10;order_id: uuid [FK ?]&#10;ticket_id: uuid [FK ?]&#10;case_kind: text [NN]&#10;category: text [NN]&#10;subject: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;open&amp;#x27;&#10;assigned_to_user_id: uuid [FK ?]&#10;escalated_at: timestamptz [?]&#10;resolved_at: timestamptz [?]&#10;updated_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: case_kind IN (&amp;#x27;attendee&amp;#x27;,&amp;#x27;organizer_platform&amp;#x27;)&#10;CK2: category IN&#10;(&amp;#x27;delivery&amp;#x27;,&amp;#x27;payment&amp;#x27;,&amp;#x27;refund&amp;#x27;,&amp;#x27;seating&amp;#x27;,&amp;#x27;event_info&amp;#x27;,&amp;#x27;check_in&amp;#x27;,&amp;#x27;account&amp;#x27;,&amp;#x27;technical&amp;#x27;)&#10;CK3: status IN (&amp;#x27;open&amp;#x27;,&amp;#x27;in_progress&amp;#x27;,&amp;#x27;waiting_customer&amp;#x27;,&amp;#x27;resolved&amp;#x27;)&#10;CK4: (status = &amp;#x27;resolved&amp;#x27;) = (resolved_at IS NOT NULL)&#10;CK5: order_id IS NULL OR event_id IS NOT NULL&#10;CK6: ticket_id IS NULL OR event_id IS NOT NULL&#10;CK7: event_id IS NULL OR organization_id IS NOT NULL&#10;CK8: case_kind &amp;lt;&amp;gt; &amp;#x27;attendee&amp;#x27; OR (event_id IS NOT NULL AND organization_id IS NOT NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id, organization_id) -&amp;gt; event(id, organization_id) [0..1 parent / 0..* children]&#10;(order_id, event_id) -&amp;gt; ticket_order(id, event_id) [0..1 parent / 0..* children]&#10;(ticket_id, event_id) -&amp;gt; ticket(id, event_id) [0..1 parent / 0..* children]&#10;(requester_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(assigned_to_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="789" as="geometry" />
        </mxCell>
        <mxCell id="support_message" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="779" width="680" height="488" as="geometry" />
        </mxCell>
        <mxCell id="support_message-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; support_message" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="50" y="779" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="support_message-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Append-only persisted message; delivery/reconnect does not duplicate it.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;case_id: uuid [FK NN]&#10;author_user_id: uuid [FK NN]&#10;client_message_id: uuid [NN]&#10;body: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (case_id, author_user_id, client_message_id)&#10;UQ2: (id, case_id)&#10;CK1: length(btrim(body)) &amp;gt; 0&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(case_id) -&amp;gt; support_case(id) [1 parent / 0..* children]&#10;(author_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="832" width="652" height="428" as="geometry" />
        </mxCell>
        <mxCell id="support_attachment" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="1045" width="680" height="431" as="geometry" />
        </mxCell>
        <mxCell id="support_attachment-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; support_attachment" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="790" y="1045" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="support_attachment-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Protected attachment belongs to an actual persisted message and its case.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;case_id: uuid [FK NN]&#10;message_id: uuid [FK NN]&#10;file_id: uuid [FK UQ NN]&#10;original_filename: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (file_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(message_id, case_id) -&amp;gt; support_message(id, case_id) [1 parent / 0..* children]&#10;(file_id) -&amp;gt; stored_file(id) [1 parent / 0..1 children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="1098" width="652" height="371" as="geometry" />
        </mxCell>
        <mxCell id="case_change" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="1303" width="680" height="488" as="geometry" />
        </mxCell>
        <mxCell id="case_change-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; case_change" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="50" y="1303" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="case_change-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Append-only status, assignment, escalation and reopening history.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;case_id: uuid [FK NN]&#10;actor_user_id: uuid [FK NN]&#10;change_kind: text [NN]&#10;before_value: text [?]&#10;after_value: text [?]&#10;reason: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: change_kind IN (&amp;#x27;status&amp;#x27;,&amp;#x27;assignment&amp;#x27;,&amp;#x27;escalation&amp;#x27;)&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(case_id) -&amp;gt; support_case(id) [1 parent / 0..* children]&#10;(actor_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="1356" width="652" height="428" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-16" name="15 Delivery and audit">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="2201" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="15 Delivery and audit / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="notification" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="526" as="geometry" />
        </mxCell>
        <mxCell id="notification-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; notification" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="notification-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Durable user inbox and email intent; context pointers still require authorization.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;recipient_user_id: uuid [FK NN]&#10;event_id: uuid [FK ?]&#10;kind: text [NN]&#10;locale: text [NN]&#10;deduplication_key: text [NN]&#10;safe_payload: jsonb [NN]&#10;read_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (recipient_user_id, deduplication_key)&#10;CK1: locale IN (&amp;#x27;kk&amp;#x27;,&amp;#x27;ru&amp;#x27;,&amp;#x27;en&amp;#x27;)&#10;CK2: jsonb_typeof(safe_payload) = &amp;#x27;object&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(recipient_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(event_id) -&amp;gt; event(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="466" as="geometry" />
        </mxCell>
        <mxCell id="notification_delivery" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="602" as="geometry" />
        </mxCell>
        <mxCell id="notification_delivery-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; notification_delivery" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="notification_delivery-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One logical delivery per channel with retry bookkeeping.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;notification_id: uuid [FK NN]&#10;channel: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;attempt_count: integer [NN]&#10;  default 0&#10;next_attempt_at: timestamptz [?]&#10;provider_message_id: text [?]&#10;sent_at: timestamptz [?]&#10;last_error: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (notification_id, channel)&#10;CK1: channel IN (&amp;#x27;email&amp;#x27;,&amp;#x27;in_app&amp;#x27;)&#10;CK2: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;sent&amp;#x27;,&amp;#x27;failed&amp;#x27;)&#10;CK3: attempt_count &amp;gt;= 0&#10;CK4: status &amp;lt;&amp;gt; &amp;#x27;sent&amp;#x27; OR sent_at IS NOT NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(notification_id) -&amp;gt; notification(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="542" as="geometry" />
        </mxCell>
        <mxCell id="outbox_job" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="722" width="680" height="716" as="geometry" />
        </mxCell>
        <mxCell id="outbox_job-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; outbox_job" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="50" y="722" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="outbox_job-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Durable job/event saved with business commit; leased for at-least-once delivery.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK ?]&#10;kind: text [NN]&#10;deduplication_key: text [UQ NN]&#10;payload: jsonb [NN]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;attempt_count: integer [NN]&#10;  default 0&#10;available_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;lease_token: uuid [?]&#10;lease_until: timestamptz [?]&#10;completed_at: timestamptz [?]&#10;last_error: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (deduplication_key)&#10;CK1: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;leased&amp;#x27;,&amp;#x27;done&amp;#x27;,&amp;#x27;dead&amp;#x27;)&#10;CK2: attempt_count &amp;gt;= 0&#10;CK3: jsonb_typeof(payload) = &amp;#x27;object&amp;#x27;&#10;CK4: (status = &amp;#x27;leased&amp;#x27; AND lease_token IS NOT NULL AND lease_until IS NOT NULL) OR&#10;(status &amp;lt;&amp;gt; &amp;#x27;leased&amp;#x27; AND lease_token IS NULL AND lease_until IS NULL)&#10;CK5: status &amp;lt;&amp;gt; &amp;#x27;done&amp;#x27; OR completed_at IS NOT NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="775" width="652" height="656" as="geometry" />
        </mxCell>
        <mxCell id="idempotency_record" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="798" width="680" height="526" as="geometry" />
        </mxCell>
        <mxCell id="idempotency_record-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; idempotency_record" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="790" y="798" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="idempotency_record-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Request deduplication; commit result with business effect, never cache auth bypass.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;actor_user_id: uuid [FK NN]&#10;operation: text [NN]&#10;request_key: text [NN]&#10;request_hash: text [NN]&#10;resource_type: text [NN]&#10;resource_id: uuid [NN]&#10;response_code: integer [NN]&#10;expires_at: timestamptz [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (actor_user_id, operation, request_key)&#10;CK1: response_code BETWEEN 200 AND 299&#10;CK2: expires_at &amp;gt; created_at&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(actor_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="851" width="652" height="466" as="geometry" />
        </mxCell>
        <mxCell id="audit_log" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="1474" width="680" height="621" as="geometry" />
        </mxCell>
        <mxCell id="audit_log-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; audit_log" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="50" y="1474" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="audit_log-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Append-only authorized activity timeline; immutable safe entity snapshots.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK ?]&#10;organization_id: uuid [FK ?]&#10;actor_user_id: uuid [FK ?]&#10;service_actor: text [?]&#10;action: text [NN]&#10;entity_type: text [NN]&#10;entity_id: uuid [NN]&#10;description: text [NN]&#10;safe_change: jsonb [NN]&#10;  default &amp;#x27;{}&amp;#x27;::jsonb&#10;correlation_id: uuid [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: num_nonnulls(actor_user_id,service_actor) = 1&#10;CK2: jsonb_typeof(safe_change) = &amp;#x27;object&amp;#x27;&#10;CK3: event_id IS NULL OR organization_id IS NOT NULL&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id, organization_id) -&amp;gt; event(id, organization_id) [0..1 parent / 0..* children]&#10;(actor_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="1527" width="652" height="561" as="geometry" />
