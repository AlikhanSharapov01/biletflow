        <mxCell id="event_report-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Signed-in report about accessible event.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;reporter_user_id: uuid [FK NN]&#10;category: text [NN]&#10;description: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;open&amp;#x27;&#10;resolved_by_user_id: uuid [FK ?]&#10;resolution: text [?]&#10;resolved_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;CK1: status IN (&amp;#x27;open&amp;#x27;,&amp;#x27;reviewing&amp;#x27;,&amp;#x27;resolved&amp;#x27;)&#10;CK2: status &amp;lt;&amp;gt; &amp;#x27;resolved&amp;#x27; OR (resolved_by_user_id IS NOT NULL AND resolved_at IS NOT NULL&#10;AND resolution IS NOT NULL)&#10;PARTIAL UQ: (event_id, reporter_user_id, category) WHERE status IN (&amp;#x27;open&amp;#x27;,&amp;#x27;reviewing&amp;#x27;)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;(reporter_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(resolved_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="542" as="geometry" />
        </mxCell>
        <mxCell id="moderation_action" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="564" as="geometry" />
        </mxCell>
        <mxCell id="moderation_action-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; moderation_action" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
