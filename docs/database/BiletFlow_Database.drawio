        <mxCell id="ga4_cache-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; ga4_cache" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
