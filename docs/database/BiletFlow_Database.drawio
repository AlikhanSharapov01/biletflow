        <mxCell id="ga4_cache-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Disposable event-scoped traffic aggregates; never financial truth.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;connection_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;query_hash: text [NN]&#10;range_start: date [NN]&#10;range_end: date [NN]&#10;metrics: jsonb [NN]&#10;fetched_at: timestamptz [NN]&#10;expires_at: timestamptz [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (connection_id, event_id, query_hash)&#10;CK1: range_end &amp;gt; range_start&#10;CK2: expires_at &amp;gt; fetched_at&#10;CK3: jsonb_typeof(metrics) = &amp;#x27;object&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(connection_id) -&amp;gt; ga4_connection(id) [1 parent / 0..* children]&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
