        <mxCell id="box3-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;INSERT/UPDATE domain records + audit_log + unique outbox_job in SAME commit. A rollback leaves none of these&#10;effects.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
