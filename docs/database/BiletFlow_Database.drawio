        <mxCell id="analytics_export-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Deduplicated allowlisted optional traffic/commerce measurement.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;connection_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;order_id: uuid [FK ?]&#10;refund_id: uuid [FK ?]&#10;measurement_kind: text [NN]&#10;analytics_event_id: uuid [UQ NN]&#10;safe_payload: jsonb [NN]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;sent_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (analytics_event_id)&#10;UQ2: (connection_id, order_id, measurement_kind)&#10;UQ3: (connection_id, refund_id, measurement_kind)&#10;CK1: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;sent&amp;#x27;,&amp;#x27;skipped&amp;#x27;,&amp;#x27;failed&amp;#x27;)&#10;CK2: jsonb_typeof(safe_payload) = &amp;#x27;object&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(connection_id) -&amp;gt; ga4_connection(id) [1 parent / 0..* children]&#10;(order_id, event_id) -&amp;gt; ticket_order(id, event_id) [0..1 parent / 0..* children]&#10;(refund_id, event_id) -&amp;gt; refund(id, event_id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
