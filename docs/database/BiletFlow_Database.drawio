        <mxCell id="venue_layout" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="488" as="geometry" />
        </mxCell>
        <mxCell id="venue_layout-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; venue_layout" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="venue_layout-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Versioned predefined layout; immutable after copied into a selling event.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;venue_id: uuid [FK NN]&#10;name: text [NN]&#10;version: integer [NN]&#10;  default 1&#10;canvas_width: integer [NN]&#10;canvas_height: integer [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (venue_id, name, version)&#10;UQ2: (id, venue_id)&#10;CK1: version &amp;gt; 0 AND canvas_width &amp;gt; 0 AND canvas_height &amp;gt; 0&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(venue_id) -&amp;gt; venue(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="428" as="geometry" />
