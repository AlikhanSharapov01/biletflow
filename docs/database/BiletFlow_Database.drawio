        </mxCell>
        <mxCell id="venue_section-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; venue_section" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="50" y="570" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="venue_section-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Section inside a layout.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;layout_id: uuid [FK NN]&#10;label: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (layout_id, label)&#10;UQ2: (id, layout_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(layout_id) -&amp;gt; venue_layout(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="623" width="652" height="333" as="geometry" />
        </mxCell>
        <mxCell id="venue_row" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="684" width="680" height="412" as="geometry" />
        </mxCell>
        <mxCell id="venue_row-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; venue_row" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="790" y="684" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="venue_row-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Numbered/labelled row in a section.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;layout_id: uuid [FK NN]&#10;section_id: uuid [FK NN]&#10;label: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (section_id, label)&#10;UQ2: (id, layout_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(section_id, layout_id) -&amp;gt; venue_section(id, layout_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="737" width="652" height="352" as="geometry" />
        </mxCell>
        <mxCell id="venue_seat" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="999" width="680" height="526" as="geometry" />
        </mxCell>
        <mxCell id="venue_seat-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; venue_seat" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="50" y="999" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="venue_seat-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Physical seat and accessibility metadata, not per-event availability.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;layout_id: uuid [FK NN]&#10;row_id: uuid [FK NN]&#10;label: text [NN]&#10;price_category: text [NN]&#10;is_accessible: boolean [NN]&#10;  default false&#10;x: numeric(10,2) [NN]&#10;y: numeric(10,2) [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (row_id, label)&#10;UQ2: (id, layout_id)&#10;CK1: x &amp;gt;= 0 AND y &amp;gt;= 0&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(row_id, layout_id) -&amp;gt; venue_row(id, layout_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="1052" width="652" height="466" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-06" name="05 Inventory">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1563" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="05 Inventory / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ticket_type" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="621" as="geometry" />
        </mxCell>
        <mxCell id="ticket_type-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; ticket_type" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ticket_type-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Event-specific free/paid product; type remains paid even if discounted to zero.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;name: text [NN]&#10;description: text [NN]&#10;kind: text [NN]&#10;price_minor: bigint [NN]&#10;quantity_limit: integer [NN]&#10;per_order_limit: integer [NN]&#10;sales_open_at: timestamptz [NN]&#10;sales_close_at: timestamptz [NN]&#10;is_hidden: boolean [NN]&#10;  default false&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, event_id)&#10;CK1: kind IN (&amp;#x27;free&amp;#x27;,&amp;#x27;paid&amp;#x27;)&#10;CK2: (kind = &amp;#x27;free&amp;#x27; AND price_minor = 0) OR (kind = &amp;#x27;paid&amp;#x27; AND price_minor &amp;gt; 0)&#10;CK3: quantity_limit &amp;gt;= 0 AND per_order_limit &amp;gt; 0&#10;CK4: sales_close_at &amp;gt; sales_open_at&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="561" as="geometry" />
        </mxCell>
        <mxCell id="event_seat" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="583" as="geometry" />
        </mxCell>
        <mxCell id="event_seat-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; event_seat" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="event_seat-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Seat copied into one event and mapped to an event ticket type.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;layout_id: uuid [FK NN]&#10;venue_seat_id: uuid [FK NN]&#10;ticket_type_id: uuid [FK NN]&#10;section_label: text [NN]&#10;row_label: text [NN]&#10;seat_label: text [NN]&#10;is_blocked: boolean [NN]&#10;  default false&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id, venue_seat_id)&#10;UQ2: (event_id, section_label, row_label, seat_label)&#10;UQ3: (id, event_id, ticket_type_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id, layout_id) -&amp;gt; event(id, venue_layout_id) [1 parent / 0..* children]&#10;(venue_seat_id, layout_id) -&amp;gt; venue_seat(id, layout_id) [1 parent / 0..* children]&#10;(ticket_type_id, event_id) -&amp;gt; ticket_type(id, event_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="523" as="geometry" />
        </mxCell>
        <mxCell id="checkout_hold" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="817" width="680" height="545" as="geometry" />
        </mxCell>
        <mxCell id="checkout_hold-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; checkout_hold" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="50" y="817" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="checkout_hold-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Authenticated basket reservation; one event and buyer per hold.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;buyer_user_id: uuid [FK NN]&#10;status: text [NN]&#10;  default &amp;#x27;active&amp;#x27;&#10;expires_at: timestamptz [NN]&#10;closed_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, event_id)&#10;UQ2: (id, event_id, buyer_user_id)&#10;CK1: status IN (&amp;#x27;active&amp;#x27;,&amp;#x27;consumed&amp;#x27;,&amp;#x27;expired&amp;#x27;,&amp;#x27;released&amp;#x27;)&#10;CK2: expires_at &amp;gt; created_at&#10;CK3: (status = &amp;#x27;active&amp;#x27;) = (closed_at IS NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;(buyer_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="870" width="652" height="485" as="geometry" />
        </mxCell>
        <mxCell id="inventory_allocation" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="779" width="680" height="678" as="geometry" />
        </mxCell>
        <mxCell id="inventory_allocation-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; inventory_allocation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="790" y="779" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="inventory_allocation-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One row per admission unit; preserve allocation history after release.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;hold_id: uuid [FK NN]&#10;ticket_type_id: uuid [FK NN]&#10;event_seat_id: uuid [FK ?]&#10;state: text [NN]&#10;  default &amp;#x27;held&amp;#x27;&#10;released_at: timestamptz [?]&#10;release_reason: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, event_id, hold_id, ticket_type_id)&#10;CK1: state IN (&amp;#x27;held&amp;#x27;,&amp;#x27;sold&amp;#x27;,&amp;#x27;refund_quarantine&amp;#x27;,&amp;#x27;released&amp;#x27;)&#10;CK2: (state = &amp;#x27;released&amp;#x27;) = (released_at IS NOT NULL)&#10;CK3: (state = &amp;#x27;released&amp;#x27;) = (release_reason IS NOT NULL)&#10;CK4: release_reason IS NULL OR release_reason IN&#10;(&amp;#x27;expired&amp;#x27;,&amp;#x27;abandoned&amp;#x27;,&amp;#x27;free_cancel&amp;#x27;,&amp;#x27;refund_succeeded&amp;#x27;)&#10;PARTIAL UQ: (event_seat_id) WHERE event_seat_id IS NOT NULL AND state IN&#10;(&amp;#x27;held&amp;#x27;,&amp;#x27;sold&amp;#x27;,&amp;#x27;refund_quarantine&amp;#x27;)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(hold_id, event_id) -&amp;gt; checkout_hold(id, event_id) [1 parent / 0..* children]&#10;(ticket_type_id, event_id) -&amp;gt; ticket_type(id, event_id) [1 parent / 0..* children]&#10;(event_seat_id, event_id, ticket_type_id) -&amp;gt; event_seat(id, event_id, ticket_type_id)&#10;[0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="832" width="652" height="618" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-07" name="06 Orders">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1305" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="06 Orders / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ticket_order" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="1039" as="geometry" />
        </mxCell>
        <mxCell id="ticket_order-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; ticket_order" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ticket_order-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One event per order; immutable quote and lifecycle separate from payment attempts.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;buyer_user_id: uuid [FK NN]&#10;hold_id: uuid [FK UQ NN]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;currency: text [NN]&#10;  default &amp;#x27;KZT&amp;#x27;&#10;gross_minor: bigint [NN]&#10;discount_minor: bigint [NN]&#10;  default 0&#10;payable_minor: bigint [NN]&#10;processing_fee_minor: bigint [NN]&#10;  default 0&#10;processing_rate_bps: integer [NN]&#10;  default 300&#10;policy_snapshot: jsonb [NN]&#10;event_snapshot: jsonb [NN]&#10;quote_expires_at: timestamptz [NN]&#10;confirmed_at: timestamptz [?]&#10;fulfillment_payment_attempt_id: uuid [FK UQ ?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (hold_id)&#10;UQ2: (fulfillment_payment_attempt_id)&#10;UQ3: (id, event_id)&#10;UQ4: (id, event_id, hold_id)&#10;CK1: status IN&#10;(&amp;#x27;pending&amp;#x27;,&amp;#x27;confirmed&amp;#x27;,&amp;#x27;failed&amp;#x27;,&amp;#x27;expired&amp;#x27;,&amp;#x27;cancelled&amp;#x27;,&amp;#x27;refund_pending&amp;#x27;,&amp;#x27;refunded&amp;#x27;)&#10;CK2: currency = &amp;#x27;KZT&amp;#x27;&#10;CK3: gross_minor &amp;gt;= 0 AND discount_minor BETWEEN 0 AND gross_minor&#10;CK4: payable_minor = gross_minor - discount_minor&#10;CK5: processing_fee_minor BETWEEN 0 AND payable_minor&#10;CK6: processing_rate_bps BETWEEN 0 AND 10000&#10;CK7: jsonb_typeof(policy_snapshot) = &amp;#x27;object&amp;#x27; AND jsonb_typeof(event_snapshot) = &amp;#x27;object&amp;#x27;&#10;CK8: status NOT IN (&amp;#x27;confirmed&amp;#x27;,&amp;#x27;refund_pending&amp;#x27;,&amp;#x27;refunded&amp;#x27;) OR confirmed_at IS NOT NULL&#10;CK9: confirmed_at IS NULL OR ((payable_minor = 0 AND fulfillment_payment_attempt_id IS&#10;NULL) OR (payable_minor &amp;gt; 0 AND fulfillment_payment_attempt_id IS NOT NULL))&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(hold_id, event_id, buyer_user_id) -&amp;gt; checkout_hold(id, event_id, buyer_user_id) [1&#10;parent / 0..1 children]&#10;(fulfillment_payment_attempt_id, event_id) -&amp;gt; payment_attempt(id, event_id) [0..1 parent&#10;/ 0..1 children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="979" as="geometry" />
        </mxCell>
        <mxCell id="order_item" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="868" as="geometry" />
        </mxCell>
        <mxCell id="order_item-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; order_item" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#805AD5;strokeColor=#805AD5;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="order_item-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One admission unit, not an aggregate line: simplifies seat, recipient, ticket and refund&#10;mapping.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;order_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;hold_id: uuid [FK NN]&#10;ticket_type_id: uuid [FK NN]&#10;allocation_id: uuid [FK UQ NN]&#10;unit_number: integer [NN]&#10;ticket_type_name: text [NN]&#10;recipient_name: text [NN]&#10;recipient_email: text [NN]&#10;face_value_minor: bigint [NN]&#10;discount_minor: bigint [NN]&#10;  default 0&#10;paid_minor: bigint [NN]&#10;processing_fee_minor: bigint [NN]&#10;  default 0&#10;seat_snapshot: jsonb [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (allocation_id)&#10;UQ2: (order_id, unit_number)&#10;UQ3: (id, event_id)&#10;CK1: unit_number &amp;gt; 0&#10;CK2: recipient_email = lower(btrim(recipient_email))&#10;CK3: face_value_minor &amp;gt;= 0 AND discount_minor BETWEEN 0 AND face_value_minor&#10;CK4: paid_minor = face_value_minor - discount_minor&#10;CK5: processing_fee_minor BETWEEN 0 AND paid_minor&#10;CK6: seat_snapshot IS NULL OR jsonb_typeof(seat_snapshot) = &amp;#x27;object&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(order_id, event_id, hold_id) -&amp;gt; ticket_order(id, event_id, hold_id) [1 parent / 0..*&#10;children]&#10;(allocation_id, event_id, hold_id, ticket_type_id) -&amp;gt; inventory_allocation(id, event_id,&#10;hold_id, ticket_type_id) [1 parent / 0..1 children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="808" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-08" name="07 Payments">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1639" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="07 Payments / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="payment_intent" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="659" as="geometry" />
        </mxCell>
        <mxCell id="payment_intent-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; payment_intent" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="payment_intent-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One payment obligation for an order or event activation; retries belong to attempts.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;order_id: uuid [FK UQ ?]&#10;activation_id: uuid [FK UQ ?]&#10;purpose: text [NN]&#10;expected_minor: bigint [NN]&#10;currency: text [NN]&#10;  default &amp;#x27;KZT&amp;#x27;&#10;environment: text [NN]&#10;  default &amp;#x27;simulation&amp;#x27;&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (order_id)&#10;UQ2: (activation_id)&#10;UQ3: (id, event_id, environment)&#10;CK1: (purpose = &amp;#x27;ticket_order&amp;#x27; AND order_id IS NOT NULL AND activation_id IS NULL) OR&#10;(purpose = &amp;#x27;activation&amp;#x27; AND activation_id IS NOT NULL AND order_id IS NULL)&#10;CK2: expected_minor &amp;gt; 0&#10;CK3: currency = &amp;#x27;KZT&amp;#x27;&#10;CK4: environment IN (&amp;#x27;simulation&amp;#x27;,&amp;#x27;sandbox&amp;#x27;)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(order_id, event_id) -&amp;gt; ticket_order(id, event_id) [0..1 parent / 0..1 children]&#10;(activation_id, event_id) -&amp;gt; sales_activation(id, event_id) [0..1 parent / 0..1 children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="599" as="geometry" />
        </mxCell>
        <mxCell id="payment_attempt" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="830" as="geometry" />
        </mxCell>
        <mxCell id="payment_attempt-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; payment_attempt" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="payment_attempt-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Provider attempts preserve even duplicate successful charges; fulfillment chooses only&#10;one.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;intent_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;environment: text [FK NN]&#10;provider: text [NN]&#10;merchant_account_key: text [NN]&#10;provider_payment_id: text [?]&#10;request_key: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;created&amp;#x27;&#10;charged_minor: bigint [NN]&#10;  default 0&#10;processing_fee_minor: bigint [NN]&#10;  default 0&#10;confirmed_at: timestamptz [?]&#10;next_reconcile_at: timestamptz [?]&#10;safe_result: jsonb [NN]&#10;  default &amp;#x27;{}&amp;#x27;::jsonb&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (provider, environment, merchant_account_key, provider_payment_id)&#10;UQ2: (provider, environment, merchant_account_key, request_key)&#10;UQ3: (id, event_id)&#10;CK1: status IN (&amp;#x27;created&amp;#x27;,&amp;#x27;pending&amp;#x27;,&amp;#x27;succeeded&amp;#x27;,&amp;#x27;failed&amp;#x27;)&#10;CK2: charged_minor &amp;gt;= 0 AND processing_fee_minor BETWEEN 0 AND charged_minor&#10;CK3: (status = &amp;#x27;succeeded&amp;#x27;) = (confirmed_at IS NOT NULL)&#10;CK4: status &amp;lt;&amp;gt; &amp;#x27;succeeded&amp;#x27; OR charged_minor &amp;gt; 0&#10;CK5: jsonb_typeof(safe_result) = &amp;#x27;object&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(intent_id, event_id, environment) -&amp;gt; payment_intent(id, event_id, environment) [1 parent&#10;/ 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="770" as="geometry" />
        </mxCell>
        <mxCell id="provider_event" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="855" width="680" height="678" as="geometry" />
        </mxCell>
        <mxCell id="provider_event-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; provider_event" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#245C80;strokeColor=#245C80;">
          <mxGeometry x="50" y="855" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="provider_event-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Verified callback inbox; save received and processed times independently.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;provider: text [NN]&#10;environment: text [NN]&#10;merchant_account_key: text [NN]&#10;external_event_id: text [NN]&#10;payment_attempt_id: uuid [FK ?]&#10;refund_attempt_id: uuid [FK ?]&#10;payload_hash: text [NN]&#10;safe_payload: jsonb [NN]&#10;status: text [NN]&#10;  default &amp;#x27;received&amp;#x27;&#10;processed_at: timestamptz [?]&#10;rejection_reason: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (provider, environment, merchant_account_key, external_event_id)&#10;CK1: environment IN (&amp;#x27;simulation&amp;#x27;,&amp;#x27;sandbox&amp;#x27;)&#10;CK2: status IN (&amp;#x27;received&amp;#x27;,&amp;#x27;processed&amp;#x27;,&amp;#x27;rejected&amp;#x27;)&#10;CK3: num_nonnulls(payment_attempt_id,refund_attempt_id) &amp;lt;= 1&#10;CK4: jsonb_typeof(safe_payload) = &amp;#x27;object&amp;#x27;&#10;CK5: status &amp;lt;&amp;gt; &amp;#x27;processed&amp;#x27; OR processed_at IS NOT NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(payment_attempt_id) -&amp;gt; payment_attempt(id) [0..1 parent / 0..* children]&#10;(refund_attempt_id) -&amp;gt; refund_attempt(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="908" width="652" height="618" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-09" name="08 Activation">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1791" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="08 Activation / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="payout_profile" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="564" as="geometry" />
        </mxCell>
        <mxCell id="payout_profile-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; payout_profile" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="payout_profile-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Protected organizer payout destination; simulator reference or encrypted sandbox profile.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;organization_id: uuid [FK NN]&#10;environment: text [NN]&#10;  default &amp;#x27;simulation&amp;#x27;&#10;provider: text [NN]&#10;provider_reference: text [?]&#10;encrypted_details: bytea [?]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;verified_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, organization_id)&#10;CK1: environment IN (&amp;#x27;simulation&amp;#x27;,&amp;#x27;sandbox&amp;#x27;)&#10;CK2: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;verified&amp;#x27;,&amp;#x27;rejected&amp;#x27;)&#10;CK3: status &amp;lt;&amp;gt; &amp;#x27;verified&amp;#x27; OR verified_at IS NOT NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(organization_id) -&amp;gt; organization(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="504" as="geometry" />
        </mxCell>
        <mxCell id="verification_record" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="602" as="geometry" />
        </mxCell>
        <mxCell id="verification_record-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; verification_record" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="verification_record-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Retained demo/sandbox identity decisions; no production KYC documents.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;organization_id: uuid [FK NN]&#10;submitted_by_user_id: uuid [FK NN]&#10;reviewed_by_user_id: uuid [FK ?]&#10;environment: text [NN]&#10;  default &amp;#x27;simulation&amp;#x27;&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;reviewed_at: timestamptz [?]&#10;reason: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, organization_id)&#10;CK1: environment IN (&amp;#x27;simulation&amp;#x27;,&amp;#x27;sandbox&amp;#x27;)&#10;CK2: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;approved&amp;#x27;,&amp;#x27;rejected&amp;#x27;)&#10;CK3: status = &amp;#x27;pending&amp;#x27; OR reviewed_at IS NOT NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(organization_id) -&amp;gt; organization(id) [1 parent / 0..* children]&#10;(submitted_by_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(reviewed_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="542" as="geometry" />
        </mxCell>
        <mxCell id="terms_acceptance" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="760" width="680" height="469" as="geometry" />
        </mxCell>
        <mxCell id="terms_acceptance-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; terms_acceptance" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
          <mxGeometry x="50" y="760" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="terms_acceptance-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Immutable evidence of event paid-terms acceptance.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;accepted_by_user_id: uuid [FK NN]&#10;terms_version: text [NN]&#10;terms_hash: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id, terms_version, accepted_by_user_id)&#10;UQ2: (id, event_id)&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;(accepted_by_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="813" width="652" height="409" as="geometry" />
        </mxCell>
        <mxCell id="sales_activation" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="798" width="680" height="887" as="geometry" />
        </mxCell>
        <mxCell id="sales_activation-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; sales_activation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7B341E;strokeColor=#7B341E;">
          <mxGeometry x="790" y="798" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="sales_activation-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Event-level checklist and paid-sales gate.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK UQ NN]&#10;organization_id: uuid [FK NN]&#10;payout_profile_id: uuid [FK ?]&#10;verification_record_id: uuid [FK ?]&#10;terms_acceptance_id: uuid [FK ?]&#10;status: text [NN]&#10;  default &amp;#x27;incomplete&amp;#x27;&#10;activation_fee_minor: bigint [NN]&#10;  default 500000&#10;currency: text [NN]&#10;  default &amp;#x27;KZT&amp;#x27;&#10;paid_attempt_id: uuid [FK UQ ?]&#10;activated_at: timestamptz [?]&#10;suspension_reason: text [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id)&#10;UQ2: (paid_attempt_id)&#10;UQ3: (id, event_id)&#10;CK1: status IN (&amp;#x27;incomplete&amp;#x27;,&amp;#x27;pending&amp;#x27;,&amp;#x27;active&amp;#x27;,&amp;#x27;failed&amp;#x27;,&amp;#x27;suspended&amp;#x27;)&#10;CK2: activation_fee_minor &amp;gt; 0 AND currency = &amp;#x27;KZT&amp;#x27;&#10;CK3: status &amp;lt;&amp;gt; &amp;#x27;active&amp;#x27; OR (payout_profile_id IS NOT NULL AND verification_record_id IS&#10;NOT NULL AND terms_acceptance_id IS NOT NULL AND paid_attempt_id IS NOT NULL AND&#10;activated_at IS NOT NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id, organization_id) -&amp;gt; event(id, organization_id) [1 parent / 0..1 children]&#10;(payout_profile_id, organization_id) -&amp;gt; payout_profile(id, organization_id) [0..1 parent&#10;/ 0..* children]&#10;(verification_record_id, organization_id) -&amp;gt; verification_record(id, organization_id)&#10;[0..1 parent / 0..* children]&#10;(terms_acceptance_id, event_id) -&amp;gt; terms_acceptance(id, event_id) [0..1 parent / 0..1&#10;children]&#10;(paid_attempt_id, event_id) -&amp;gt; payment_attempt(id, event_id) [0..1 parent / 0..1&#10;children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="851" width="652" height="827" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-10" name="09 Campaigns">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="2011" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="09 Campaigns / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="campaign" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="640" as="geometry" />
        </mxCell>
        <mxCell id="campaign-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; campaign" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="campaign-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One discount definition per event; edits do not rewrite purchased snapshots.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;name: text [NN]&#10;discount_kind: text [NN]&#10;percentage_bps: integer [?]&#10;fixed_minor: bigint [?]&#10;starts_at: timestamptz [NN]&#10;ends_at: timestamptz [NN]&#10;max_redemptions: integer [NN]&#10;is_enabled: boolean [NN]&#10;  default true&#10;all_ticket_types: boolean [NN]&#10;  default true&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, event_id)&#10;CK1: (discount_kind = &amp;#x27;percentage&amp;#x27; AND percentage_bps BETWEEN 1 AND 10000 AND&#10;percentage_bps IS NOT NULL AND fixed_minor IS NULL) OR (discount_kind = &amp;#x27;fixed&amp;#x27; AND&#10;fixed_minor &amp;gt; 0 AND fixed_minor IS NOT NULL AND percentage_bps IS NULL)&#10;CK2: ends_at &amp;gt; starts_at AND max_redemptions &amp;gt; 0&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="580" as="geometry" />
        </mxCell>
        <mxCell id="campaign_ticket_type" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="412" as="geometry" />
        </mxCell>
        <mxCell id="campaign_ticket_type-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; campaign_ticket_type" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="campaign_ticket_type-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Eligible ticket types; composite FKs prevent cross-event discounts.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;campaign_id: uuid [FK NN]&#10;ticket_type_id: uuid [FK NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (campaign_id, ticket_type_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(campaign_id, event_id) -&amp;gt; campaign(id, event_id) [1 parent / 0..* children]&#10;(ticket_type_id, event_id) -&amp;gt; ticket_type(id, event_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="352" as="geometry" />
        </mxCell>
        <mxCell id="promo_code" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="836" width="680" height="507" as="geometry" />
        </mxCell>
        <mxCell id="promo_code-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; promo_code" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="50" y="836" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="promo_code-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Human code and separate opaque campaign-link token.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;campaign_id: uuid [FK NN]&#10;code_normalized: text [UQ NN]&#10;link_token_hash: text [UQ NN]&#10;is_enabled: boolean [NN]&#10;  default true&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (code_normalized)&#10;UQ2: (link_token_hash)&#10;UQ3: (id, event_id, campaign_id)&#10;CK1: code_normalized = upper(btrim(code_normalized))&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(campaign_id, event_id) -&amp;gt; campaign(id, event_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="889" width="652" height="447" as="geometry" />
        </mxCell>
        <mxCell id="promo_reservation" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="608" width="680" height="602" as="geometry" />
        </mxCell>
        <mxCell id="promo_reservation-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; promo_reservation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="790" y="608" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="promo_reservation-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One active redemption allowance per hold; released/consumed history retained.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;campaign_id: uuid [FK NN]&#10;promo_code_id: uuid [FK NN]&#10;hold_id: uuid [FK NN]&#10;status: text [NN]&#10;  default &amp;#x27;active&amp;#x27;&#10;expires_at: timestamptz [NN]&#10;discount_snapshot: jsonb [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, event_id, campaign_id)&#10;CK1: status IN (&amp;#x27;active&amp;#x27;,&amp;#x27;consumed&amp;#x27;,&amp;#x27;released&amp;#x27;)&#10;CK2: expires_at &amp;gt; created_at&#10;CK3: jsonb_typeof(discount_snapshot) = &amp;#x27;object&amp;#x27;&#10;PARTIAL UQ: (hold_id) WHERE status = &amp;#x27;active&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(promo_code_id, event_id, campaign_id) -&amp;gt; promo_code(id, event_id, campaign_id) [1 parent&#10;/ 0..* children]&#10;(hold_id, event_id) -&amp;gt; checkout_hold(id, event_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="661" width="652" height="542" as="geometry" />
        </mxCell>
        <mxCell id="promo_redemption" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="1379" width="680" height="526" as="geometry" />
        </mxCell>
        <mxCell id="promo_redemption-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; promo_redemption" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#22577A;strokeColor=#22577A;">
          <mxGeometry x="50" y="1379" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="promo_redemption-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Immutable successful-order attribution; refund never deletes/replenishes it.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;campaign_id: uuid [FK NN]&#10;reservation_id: uuid [FK UQ NN]&#10;order_id: uuid [FK UQ NN]&#10;discount_minor: bigint [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (order_id)&#10;UQ2: (reservation_id)&#10;CK1: discount_minor &amp;gt;= 0&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(reservation_id, event_id, campaign_id) -&amp;gt; promo_reservation(id, event_id, campaign_id)&#10;[1 parent / 0..1 children]&#10;(order_id, event_id) -&amp;gt; ticket_order(id, event_id) [1 parent / 0..1 children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="1432" width="652" height="466" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-11" name="10 Tickets">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1601" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="10 Tickets / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ticket" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="716" as="geometry" />
        </mxCell>
        <mxCell id="ticket-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; ticket" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ticket-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One canonical ticket per unit; buyer and recipient are distinct.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;order_item_id: uuid [FK UQ NN]&#10;recipient_user_id: uuid [FK ?]&#10;status: text [NN]&#10;  default &amp;#x27;valid&amp;#x27;&#10;qr_token_hash: text [UQ NN]&#10;token_version: integer [NN]&#10;  default 1&#10;claimed_at: timestamptz [?]&#10;issued_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;pdf_file_id: uuid [FK ?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (order_item_id)&#10;UQ2: (qr_token_hash)&#10;UQ3: (id, event_id)&#10;UQ4: (id, event_id, recipient_user_id)&#10;CK1: status IN (&amp;#x27;valid&amp;#x27;,&amp;#x27;checked_in&amp;#x27;,&amp;#x27;refund_pending&amp;#x27;,&amp;#x27;refunded&amp;#x27;,&amp;#x27;cancelled&amp;#x27;)&#10;CK2: token_version &amp;gt; 0&#10;CK3: (recipient_user_id IS NULL) = (claimed_at IS NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(order_item_id, event_id) -&amp;gt; order_item(id, event_id) [1 parent / 0..1 children]&#10;(recipient_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;(pdf_file_id) -&amp;gt; stored_file(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="656" as="geometry" />
        </mxCell>
        <mxCell id="ticket_claim" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="526" as="geometry" />
        </mxCell>
        <mxCell id="ticket_claim-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; ticket_claim" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ticket_claim-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Expiring claim challenge; intended email comes from immutable order item.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;ticket_id: uuid [FK NN]&#10;token_hash: text [UQ NN]&#10;expires_at: timestamptz [NN]&#10;consumed_at: timestamptz [?]&#10;consumed_by_user_id: uuid [FK ?]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (token_hash)&#10;CK1: expires_at &amp;gt; created_at&#10;CK2: (consumed_at IS NULL) = (consumed_by_user_id IS NULL)&#10;PARTIAL UQ: (ticket_id) WHERE consumed_at IS NULL AND revoked_at IS NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(ticket_id) -&amp;gt; ticket(id) [1 parent / 0..* children]&#10;(consumed_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="466" as="geometry" />
        </mxCell>
        <mxCell id="entry_confirmation" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="912" width="680" height="583" as="geometry" />
        </mxCell>
        <mxCell id="entry_confirmation-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; entry_confirmation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#276749;strokeColor=#276749;">
          <mxGeometry x="50" y="912" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="entry_confirmation-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Short-lived signed-in attendee proof; separate from printed ticket identity.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;ticket_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;attendee_user_id: uuid [FK NN]&#10;session_id: uuid [FK NN]&#10;token_hash: text [UQ NN]&#10;signing_key_id: text [NN]&#10;expires_at: timestamptz [NN]&#10;consumed_at: timestamptz [?]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (token_hash)&#10;UQ2: (id, ticket_id, event_id)&#10;CK1: expires_at &amp;gt; created_at&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(ticket_id, event_id, attendee_user_id) -&amp;gt; ticket(id, event_id, recipient_user_id) [1&#10;parent / 0..* children]&#10;(session_id, attendee_user_id) -&amp;gt; auth_session(id, user_id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="965" width="652" height="523" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-12" name="11 Admission">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1202" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="11 Admission / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="scanner_device" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="450" as="geometry" />
        </mxCell>
        <mxCell id="scanner_device-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; scanner_device" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="scanner_device-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Registered scanner installation, owned by one account; event permissions checked&#10;separately.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;owner_user_id: uuid [FK NN]&#10;device_key: text [UQ NN]&#10;label: text [NN]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (device_key)&#10;UQ2: (id, owner_user_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(owner_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="390" as="geometry" />
        </mxCell>
        <mxCell id="check_in" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="735" as="geometry" />
        </mxCell>
        <mxCell id="check_in-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; check_in" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="check_in-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Append-preserved accepted admission; current state represented by reversed_at.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;ticket_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;entry_confirmation_id: uuid [FK UQ NN]&#10;scanner_user_id: uuid [FK NN]&#10;scanner_session_id: uuid [FK NN]&#10;device_id: uuid [FK NN]&#10;operation_id: uuid [NN]&#10;source: text [NN]&#10;accepted_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;captured_at: timestamptz [NN]&#10;reversed_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (device_id, operation_id)&#10;UQ2: (entry_confirmation_id)&#10;UQ3: (id, ticket_id, event_id)&#10;CK1: source IN (&amp;#x27;online&amp;#x27;,&amp;#x27;offline_sync&amp;#x27;)&#10;PARTIAL UQ: (ticket_id) WHERE reversed_at IS NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(entry_confirmation_id, ticket_id, event_id) -&amp;gt; entry_confirmation(id, ticket_id,&#10;event_id) [1 parent / 0..1 children]&#10;(scanner_session_id, scanner_user_id) -&amp;gt; auth_session(id, user_id) [1 parent / 0..*&#10;children]&#10;(device_id, scanner_user_id) -&amp;gt; scanner_device(id, owner_user_id) [1 parent / 0..*&#10;children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="675" as="geometry" />
        </mxCell>
        <mxCell id="check_in_reversal" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="646" width="680" height="450" as="geometry" />
        </mxCell>
        <mxCell id="check_in_reversal-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; check_in_reversal" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="50" y="646" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="check_in_reversal-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One retained reversal for an accepted admission; never erase original row.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;check_in_id: uuid [FK UQ NN]&#10;actor_user_id: uuid [FK NN]&#10;reason: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (check_in_id)&#10;CK1: length(btrim(reason)) &amp;gt; 0&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(check_in_id) -&amp;gt; check_in(id) [1 parent / 0..1 children]&#10;(actor_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="699" width="652" height="390" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-13" name="12 Refunds and finance">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1696" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="12 Refunds and finance / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="refund" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="697" as="geometry" />
        </mxCell>
        <mxCell id="refund-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; refund" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="refund-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;One full refund obligation per successful charge, including compensating duplicate/late&#10;charges.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;payment_attempt_id: uuid [FK UQ NN]&#10;event_id: uuid [FK NN]&#10;reason: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;requested&amp;#x27;&#10;amount_minor: bigint [NN]&#10;requested_by_user_id: uuid [FK ?]&#10;approved_by_user_id: uuid [FK ?]&#10;succeeded_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (payment_attempt_id)&#10;UQ2: (id, event_id)&#10;CK1: reason IN&#10;(&amp;#x27;voluntary&amp;#x27;,&amp;#x27;event_cancelled&amp;#x27;,&amp;#x27;late_payment&amp;#x27;,&amp;#x27;duplicate_charge&amp;#x27;,&amp;#x27;blocked_fulfillment&amp;#x27;)&#10;CK2: status IN (&amp;#x27;requested&amp;#x27;,&amp;#x27;pending&amp;#x27;,&amp;#x27;failed&amp;#x27;,&amp;#x27;succeeded&amp;#x27;)&#10;CK3: amount_minor &amp;gt; 0&#10;CK4: (status = &amp;#x27;succeeded&amp;#x27;) = (succeeded_at IS NOT NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(payment_attempt_id, event_id) -&amp;gt; payment_attempt(id, event_id) [1 parent / 0..1&#10;children]&#10;(requested_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;(approved_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="637" as="geometry" />
        </mxCell>
        <mxCell id="refund_attempt" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="602" as="geometry" />
        </mxCell>
        <mxCell id="refund_attempt-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; refund_attempt" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="refund_attempt-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Transport attempts for the same logical refund. Uncertain outcome reconciles before&#10;resend.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;refund_id: uuid [FK NN]&#10;attempt_number: integer [NN]&#10;provider_refund_id: text [?]&#10;provider_request_key: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;sent_at: timestamptz [?]&#10;resolved_at: timestamptz [?]&#10;safe_result: jsonb [NN]&#10;  default &amp;#x27;{}&amp;#x27;::jsonb&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (refund_id, attempt_number)&#10;CK1: attempt_number &amp;gt; 0&#10;CK2: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;succeeded&amp;#x27;,&amp;#x27;failed&amp;#x27;,&amp;#x27;unknown&amp;#x27;)&#10;CK3: jsonb_typeof(safe_result) = &amp;#x27;object&amp;#x27;&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(refund_id) -&amp;gt; refund(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="542" as="geometry" />
        </mxCell>
        <mxCell id="demo_payout" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="893" width="680" height="640" as="geometry" />
        </mxCell>
        <mxCell id="demo_payout-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; demo_payout" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="50" y="893" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="demo_payout-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Event-scoped payout simulation; never represents a real bank transfer.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;organization_id: uuid [FK NN]&#10;payout_profile_id: uuid [FK NN]&#10;amount_minor: bigint [NN]&#10;currency: text [NN]&#10;  default &amp;#x27;KZT&amp;#x27;&#10;status: text [NN]&#10;  default &amp;#x27;pending&amp;#x27;&#10;request_key: text [NN]&#10;sent_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id, request_key)&#10;UQ2: (id, event_id)&#10;CK1: amount_minor &amp;gt; 0 AND currency = &amp;#x27;KZT&amp;#x27;&#10;CK2: status IN (&amp;#x27;pending&amp;#x27;,&amp;#x27;eligible&amp;#x27;,&amp;#x27;sent&amp;#x27;,&amp;#x27;failed&amp;#x27;)&#10;CK3: (status = &amp;#x27;sent&amp;#x27;) = (sent_at IS NOT NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id, organization_id) -&amp;gt; event(id, organization_id) [1 parent / 0..* children]&#10;(payout_profile_id, organization_id) -&amp;gt; payout_profile(id, organization_id) [1 parent /&#10;0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="946" width="652" height="580" as="geometry" />
        </mxCell>
        <mxCell id="finance_entry" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="798" width="680" height="792" as="geometry" />
        </mxCell>
        <mxCell id="finance_entry-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; finance_entry" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#9C4221;strokeColor=#9C4221;">
          <mxGeometry x="790" y="798" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="finance_entry-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Append-only signed organizer balance effects; not a production accounting ledger.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;payment_attempt_id: uuid [FK ?]&#10;refund_id: uuid [FK ?]&#10;demo_payout_id: uuid [FK ?]&#10;kind: text [NN]&#10;amount_minor: bigint [NN]&#10;currency: text [NN]&#10;  default &amp;#x27;KZT&amp;#x27;&#10;environment: text [NN]&#10;effective_at: timestamptz [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (payment_attempt_id, kind)&#10;UQ2: (refund_id, kind)&#10;UQ3: (demo_payout_id, kind)&#10;CK1: currency = &amp;#x27;KZT&amp;#x27; AND environment IN (&amp;#x27;simulation&amp;#x27;,&amp;#x27;sandbox&amp;#x27;)&#10;CK2: (kind IN (&amp;#x27;sale&amp;#x27;,&amp;#x27;processing_fee&amp;#x27;,&amp;#x27;activation_fee&amp;#x27;) AND payment_attempt_id IS NOT&#10;NULL AND refund_id IS NULL AND demo_payout_id IS NULL) OR (kind IN&#10;(&amp;#x27;refund&amp;#x27;,&amp;#x27;fee_reversal&amp;#x27;,&amp;#x27;activation_refund&amp;#x27;) AND refund_id IS NOT NULL AND&#10;payment_attempt_id IS NULL AND demo_payout_id IS NULL) OR (kind = &amp;#x27;payout&amp;#x27; AND&#10;demo_payout_id IS NOT NULL AND payment_attempt_id IS NULL AND refund_id IS NULL)&#10;CK3: (kind IN (&amp;#x27;sale&amp;#x27;,&amp;#x27;fee_reversal&amp;#x27;,&amp;#x27;activation_refund&amp;#x27;) AND amount_minor &amp;gt;= 0) OR (kind&#10;IN (&amp;#x27;processing_fee&amp;#x27;,&amp;#x27;activation_fee&amp;#x27;,&amp;#x27;refund&amp;#x27;,&amp;#x27;payout&amp;#x27;) AND amount_minor &amp;lt;= 0)&#10;TRIGGER: reject UPDATE / DELETE (append-only).&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(payment_attempt_id, event_id) -&amp;gt; payment_attempt(id, event_id) [0..1 parent / 0..*&#10;children]&#10;(refund_id, event_id) -&amp;gt; refund(id, event_id) [0..1 parent / 0..* children]&#10;(demo_payout_id, event_id) -&amp;gt; demo_payout(id, event_id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="851" width="652" height="732" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bf-page-14" name="13 Offline synchronization">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1525" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="13 Offline synchronization / physical tables" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17324D;spacing=0;">
          <mxGeometry x="50" y="28" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Each class lists attributes, keys, CHECK expressions and complete outbound FK mappings. FK line: parent multiplicity / children per parent." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#526477;spacing=0;">
          <mxGeometry x="50" y="82" width="1420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="offline_package" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="160" width="680" height="640" as="geometry" />
        </mxCell>
        <mxCell id="offline_package-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; offline_package" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="offline_package-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Expiring signed event manifest for a specific scanner device/session.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;scanner_user_id: uuid [FK NN]&#10;session_id: uuid [FK NN]&#10;device_id: uuid [FK NN]&#10;file_id: uuid [FK NN]&#10;snapshot_version: bigint [NN]&#10;expires_at: timestamptz [NN]&#10;content_hash: text [NN]&#10;signing_key_id: text [NN]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (id, event_id, device_id)&#10;CK1: snapshot_version &amp;gt;= 0&#10;CK2: expires_at &amp;gt; created_at&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(session_id, scanner_user_id) -&amp;gt; auth_session(id, user_id) [1 parent / 0..* children]&#10;(device_id, scanner_user_id) -&amp;gt; scanner_device(id, owner_user_id) [1 parent / 0..*&#10;children]&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;(file_id) -&amp;gt; stored_file(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="580" as="geometry" />
        </mxCell>
        <mxCell id="offline_operation" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="849" as="geometry" />
        </mxCell>
        <mxCell id="offline_operation-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; offline_operation" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="offline_operation-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Retained raw client intent and per-operation reconciliation outcome; not authoritative&#10;admission.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;package_id: uuid [FK NN]&#10;event_id: uuid [FK NN]&#10;device_id: uuid [FK NN]&#10;operation_id: uuid [NN]&#10;sequence_number: bigint [NN]&#10;kind: text [NN]&#10;claimed_ticket_id: uuid [?]&#10;claimed_confirmation_id: uuid [?]&#10;parent_operation_id: uuid [?]&#10;captured_at: timestamptz [NN]&#10;payload_hash: text [NN]&#10;status: text [NN]&#10;  default &amp;#x27;received&amp;#x27;&#10;resolved_ticket_id: uuid [FK ?]&#10;accepted_check_in_id: uuid [FK ?]&#10;rejection_code: text [?]&#10;processed_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (device_id, operation_id)&#10;UQ2: (package_id, sequence_number)&#10;CK1: sequence_number &amp;gt; 0&#10;CK2: kind IN (&amp;#x27;check_in&amp;#x27;,&amp;#x27;reverse&amp;#x27;)&#10;CK3: status IN (&amp;#x27;received&amp;#x27;,&amp;#x27;accepted&amp;#x27;,&amp;#x27;duplicate&amp;#x27;,&amp;#x27;rejected&amp;#x27;,&amp;#x27;conflict&amp;#x27;)&#10;CK4: (kind = &amp;#x27;reverse&amp;#x27;) = (parent_operation_id IS NOT NULL)&#10;CK5: status = &amp;#x27;received&amp;#x27; OR processed_at IS NOT NULL&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(package_id, event_id, device_id) -&amp;gt; offline_package(id, event_id, device_id) [1 parent /&#10;0..* children]&#10;(resolved_ticket_id, event_id) -&amp;gt; ticket(id, event_id) [0..1 parent / 0..* children]&#10;(accepted_check_in_id) -&amp;gt; check_in(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="789" as="geometry" />
        </mxCell>
        <mxCell id="sync_conflict" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="836" width="680" height="583" as="geometry" />
        </mxCell>
        <mxCell id="sync_conflict-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; sync_conflict" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#285E61;strokeColor=#285E61;">
          <mxGeometry x="50" y="836" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="sync_conflict-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Organizer review of conflicting provisional operation; cannot create a second admission.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;offline_operation_id: uuid [FK UQ NN]&#10;existing_check_in_id: uuid [FK ?]&#10;status: text [NN]&#10;  default &amp;#x27;open&amp;#x27;&#10;reason: text [NN]&#10;resolved_by_user_id: uuid [FK ?]&#10;resolution_note: text [?]&#10;resolved_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (offline_operation_id)&#10;CK1: status IN (&amp;#x27;open&amp;#x27;,&amp;#x27;resolved&amp;#x27;)&#10;CK2: status &amp;lt;&amp;gt; &amp;#x27;resolved&amp;#x27; OR (resolved_by_user_id IS NOT NULL AND resolved_at IS NOT NULL&#10;AND resolution_note IS NOT NULL)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(offline_operation_id) -&amp;gt; offline_operation(id) [1 parent / 0..1 children]&#10;(existing_check_in_id) -&amp;gt; check_in(id) [0..1 parent / 0..* children]&#10;(resolved_by_user_id) -&amp;gt; app_user(id) [0..1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="889" width="652" height="523" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
