        <mxCell id="box12-body" value="&lt;div style=&quot;font-family:Arial;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;INSERT offline_operation idempotently. Untrusted claimed ticket IDs may be invalid: retain them without&#10;pretending they are FKs.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
