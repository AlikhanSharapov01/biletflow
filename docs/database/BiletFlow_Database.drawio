        </mxCell>
        <mxCell id="category-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; category" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="50" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="category-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Seeded category with three interface labels.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;code: text [UQ NN]&#10;name_kk: text [NN]&#10;name_ru: text [NN]&#10;name_en: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (code)&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="213" width="652" height="295" as="geometry" />
        </mxCell>
        <mxCell id="event" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="160" width="680" height="1305" as="geometry" />
        </mxCell>
        <mxCell id="event-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; event" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="790" y="160" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="event-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Lifecycle, time, access, capacity and calendar identity. No stored upcoming/completed&#10;flag.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;organization_id: uuid [FK NN]&#10;category_id: uuid [FK NN]&#10;venue_id: uuid [FK NN]&#10;venue_layout_id: uuid [FK ?]&#10;title: text [NN]&#10;description: text [NN]&#10;publication_state: text [NN]&#10;  default &amp;#x27;draft&amp;#x27;&#10;moderation_state: text [NN]&#10;  default &amp;#x27;normal&amp;#x27;&#10;visibility: text [NN]&#10;  default &amp;#x27;public&amp;#x27;&#10;seating_mode: text [NN]&#10;  default &amp;#x27;general&amp;#x27;&#10;capacity: integer [NN]&#10;starts_at: timestamptz [NN]&#10;ends_at: timestamptz [NN]&#10;time_zone: text [NN]&#10;  default &amp;#x27;Asia/Almaty&amp;#x27;&#10;registration_opens_at: timestamptz [NN]&#10;registration_closes_at: timestamptz [NN]&#10;admission_opens_at: timestamptz [NN]&#10;admission_closes_at: timestamptz [NN]&#10;refund_allowed: boolean [NN]&#10;  default true&#10;refund_cutoff_at: timestamptz [?]&#10;calendar_uid: text [UQ NN]&#10;calendar_sequence: integer [NN]&#10;  default 0&#10;availability_version: bigint [NN]&#10;  default 0&#10;updated_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (calendar_uid)&#10;UQ2: (id, organization_id)&#10;UQ3: (id, venue_layout_id)&#10;CK1: publication_state IN (&amp;#x27;draft&amp;#x27;,&amp;#x27;published&amp;#x27;,&amp;#x27;unpublished&amp;#x27;,&amp;#x27;cancelled&amp;#x27;)&#10;CK2: moderation_state IN (&amp;#x27;normal&amp;#x27;,&amp;#x27;suspended&amp;#x27;)&#10;CK3: visibility IN (&amp;#x27;public&amp;#x27;,&amp;#x27;unlisted&amp;#x27;,&amp;#x27;private&amp;#x27;)&#10;CK4: seating_mode IN (&amp;#x27;general&amp;#x27;,&amp;#x27;assigned&amp;#x27;)&#10;CK5: capacity &amp;gt;= 0&#10;CK6: ends_at &amp;gt; starts_at&#10;CK7: registration_closes_at &amp;gt; registration_opens_at AND registration_closes_at &amp;lt;= ends_at&#10;CK8: admission_closes_at &amp;gt; admission_opens_at&#10;CK9: NOT refund_allowed OR (refund_cutoff_at IS NOT NULL AND refund_cutoff_at &amp;lt;=&#10;starts_at)&#10;CK10: (seating_mode = &amp;#x27;assigned&amp;#x27;) = (venue_layout_id IS NOT NULL)&#10;CK11: calendar_sequence &amp;gt;= 0 AND availability_version &amp;gt;= 0&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(venue_layout_id, venue_id) -&amp;gt; venue_layout(id, venue_id) [0..1 parent / 0..* children]&#10;(category_id) -&amp;gt; category(id) [1 parent / 0..* children]&#10;(venue_id) -&amp;gt; venue(id) [1 parent / 0..* children]&#10;(organization_id) -&amp;gt; organization(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="213" width="652" height="1245" as="geometry" />
        </mxCell>
        <mxCell id="event_access_grant" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="50" y="551" width="680" height="450" as="geometry" />
        </mxCell>
        <mxCell id="event_access_grant-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; event_access_grant" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="50" y="551" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="event_access_grant-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Account-specific invitation/access grant for private event.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;user_id: uuid [FK NN]&#10;granted_by_user_id: uuid [FK NN]&#10;revoked_at: timestamptz [?]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id, user_id)&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;(user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;(granted_by_user_id) -&amp;gt; app_user(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="64" y="604" width="652" height="390" as="geometry" />
        </mxCell>
        <mxCell id="event_media" value="" vertex="1" parent="1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;">
          <mxGeometry x="790" y="1501" width="680" height="488" as="geometry" />
        </mxCell>
        <mxCell id="event_media-title" value="&amp;lt;&amp;lt;table&amp;gt;&amp;gt; event_media" vertex="1" parent="1" style="rounded=0;html=1;align=left;spacingLeft=14;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#FFFFFF;fillColor=#7056A5;strokeColor=#7056A5;">
          <mxGeometry x="790" y="1501" width="680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="event_media-body" value="&lt;div style=&quot;font-family:Consolas, monospace;font-size:13px;line-height:19px;white-space:pre;&quot;&gt;Ordered event images; storage lifecycle separate from publication.&#10;&#10;ATTRIBUTES  (NN required / ? nullable)&#10;id: uuid [PK NN]&#10;  default gen_random_uuid()&#10;event_id: uuid [FK NN]&#10;file_id: uuid [FK NN]&#10;sort_order: integer [NN]&#10;  default 0&#10;alt_text: text [NN]&#10;created_at: timestamptz [NN]&#10;  default CURRENT_TIMESTAMP&#10;&#10;CONSTRAINTS&#10;UQ1: (event_id, sort_order)&#10;UQ2: (event_id, file_id)&#10;CK1: sort_order &amp;gt;= 0&#10;&#10;FOREIGN KEYS / UML ASSOCIATIONS&#10;(event_id) -&amp;gt; event(id) [1 parent / 0..* children]&#10;(file_id) -&amp;gt; stored_file(id) [1 parent / 0..* children]&#10;All FK deletes/updates: RESTRICT. See TX rules for cross-row guards.&lt;/div&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;">
          <mxGeometry x="804" y="1554" width="652" height="428" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
